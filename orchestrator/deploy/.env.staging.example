# Copy to deploy/.env.staging and fill in. Names and safe defaults only: every secret is a file
# in ORCHESTRATOR_SECRETS_DIR on the target (see docs/operations/run-as-a-service.md), never a value here.

# Where the release goes: ssh://user@host[:port], or local for this machine's Docker.
ORCHESTRATOR_TARGET=ssh://deploy@staging.example.com
# More ssh options for the target, quoted, e.g. "-i ~/.ssh/orchestrator-staging -o UserKnownHostsFile=~/.ssh/orchestrator-known-hosts".
ORCHESTRATOR_SSH_OPTS=""
# The directory on the target that holds the compose file, the env file, secrets/ and state/.
ORCHESTRATOR_TARGET_DIR=/opt/teamhandbook-orchestrator
COMPOSE_PROJECT_NAME=teamhandbook-orchestrator-staging

# The address people open. Caddy takes a certificate for it from ORCHESTRATOR_ACME_CA.
ORCHESTRATOR_DOMAIN=orchestrator.staging.example.com
# Let's Encrypt's staging CA: its certificates are not trusted by browsers and its limits are generous.
ORCHESTRATOR_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ORCHESTRATOR_BIND=0.0.0.0
ORCHESTRATOR_HTTPS_PORT=443
ORCHESTRATOR_HTTP_PORT=80

# Relative paths are read from ORCHESTRATOR_TARGET_DIR.
ORCHESTRATOR_SECRETS_DIR=./secrets

# Copies: the orchestrator's own every ORCHESTRATOR_BACKUP_HOURS, pg_dump every ORCHESTRATOR_PG_BACKUP_HOURS.
ORCHESTRATOR_BACKUP_HOURS=24
ORCHESTRATOR_BACKUP_KEEP=7
ORCHESTRATOR_PG_BACKUP_HOURS=6
ORCHESTRATOR_PG_BACKUP_KEEP=28

# Sign-up. The privacy policy and terms of use people agree to, and at least one provider: the
# client id here, its secret as the file secrets/sign-in/<google|github|microsoft>_client_secret
# on the target. A release stops without them, unless ORCHESTRATOR_SIGN_UP=closed says on purpose
# that nobody signs up to this orchestrator.
ORCHESTRATOR_PRIVACY_URL=https://example.com/privacy
ORCHESTRATOR_TERMS_URL=https://example.com/terms
# Where "Stuck? Get help" on the sign-up page goes; empty shows no help link.
ORCHESTRATOR_HELP_URL=
ORCHESTRATOR_SIGN_IN_GOOGLE_CLIENT_ID=
ORCHESTRATOR_SIGN_IN_GITHUB_CLIENT_ID=
ORCHESTRATOR_SIGN_IN_MICROSOFT_CLIENT_ID=

# One-click GitLab and GitHub connect (docs/operations/forge-apps.md registers the applications). The ids here;
# the secrets as files under secrets/forge on the target: gitlab_client_secret for GitLab, and
# github_client_secret, github_private_key (the .pem) and github_webhook_secret (16 characters or more) for GitHub.
# ORCHESTRATOR_FORGE_GITLAB_CLIENT_ID=
# ORCHESTRATOR_FORGE_GITLAB_URL=https://gitlab.com
# ORCHESTRATOR_FORGE_GITHUB_APP_ID=
# ORCHESTRATOR_FORGE_GITHUB_APP_SLUG=
# ORCHESTRATOR_FORGE_GITHUB_CLIENT_ID=

# Tasks run on the machines people connect; 1 runs them on this server instead, each in a container of its own.
# ORCHESTRATOR_SERVER_TASKS=1

# Each organization's plan limits, until an organization's own are set: a positive whole number or unlimited.
ORCHESTRATOR_QUOTA_MEMBERS=10
ORCHESTRATOR_QUOTA_TASKS_PER_MONTH=200
ORCHESTRATOR_QUOTA_CONCURRENT_TASKS=2

# 1 adds the example in docker-compose.observability.yml: Prometheus scraping /metrics (its page
# on the host's 127.0.0.1:ORCHESTRATOR_PROMETHEUS_PORT) and Vector keeping the services' log lines a
# day to a file, sent by Docker to the host's 127.0.0.1:ORCHESTRATOR_VECTOR_PORT.
ORCHESTRATOR_OBSERVABILITY=0
ORCHESTRATOR_PROMETHEUS_PORT=9090
ORCHESTRATOR_VECTOR_PORT=24224

# Change only when 172.31.250.0/29 is taken on the target.
ORCHESTRATOR_EDGE_SUBNET=172.31.250.0/29
ORCHESTRATOR_PROXY_IP=172.31.250.2
